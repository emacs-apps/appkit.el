#!/usr/bin/env bash

set -uo pipefail
umask 077

usage() {
  cat <<'EOF'
Usage: eask-ert-brief [ERT-FILE ...]

Recompile the current package, then run `eask test ert`.  Successful runs
print only the ERT summary.  Failed runs keep compiler diagnostics or each
failing test's backtrace and condition, plus the final unexpected-results
summary.

Set EASK_BIN to use an executable path other than `eask`.
EOF
}

case "${1-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

eask_bin=${EASK_BIN:-eask}
log_file=$(mktemp "${TMPDIR:-/tmp}/eask-ert-brief.XXXXXX") || exit 2
brief_file=$(mktemp "${TMPDIR:-/tmp}/eask-ert-brief.XXXXXX") || {
  rm -f "$log_file"
  exit 2
}

# shellcheck disable=SC2329  # Called indirectly by the EXIT trap.
cleanup() {
  rm -f "$log_file" "$brief_file"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

"$eask_bin" --no-color recompile >"$log_file" 2>&1
status=$?
if (( status != 0 )); then
  cat "$log_file"
  exit "$status"
fi

"$eask_bin" --no-color test ert "$@" >"$log_file" 2>&1
status=$?

if (( status == 0 )); then
  awk '
    /^(Aborted: )?Ran [0-9]+ tests?, / { in_summary = 1 }
    in_summary { print }
  ' "$log_file" >"$brief_file"
  if [[ -s $brief_file ]]; then
    # Keep skipped/expected-failure sections that follow the Ran line; they
    # are part of the useful result, not runner progress noise.
    cat "$brief_file"
  else
    # A successful command without an ERT summary is unusual; retain its
    # output so the wrapper never hides a changed Eask contract.
    cat "$log_file"
  fi
  exit 0
fi

if ! grep -q '^Running [0-9][0-9]* tests\?' "$log_file"; then
  # Load, dependency, or Eask failures do not have ERT failure blocks.  Their
  # complete output is already the concise and actionable diagnostic.
  cat "$log_file"
  exit "$status"
fi

if awk '
  /^Test .* backtrace:$/ {
    in_failure = 1
    in_backtrace = 1
  }

  in_failure {
    if (in_backtrace && $0 ~ /^  ert--run-test-internal\(/) {
      print "  ... ERT runner frames omitted ..."
      omit_runner = 1
      next
    }
    if (omit_runner && $0 !~ /^Test .* condition:$/) {
      next
    }
    if ($0 ~ /^Test .* condition:$/) {
      in_backtrace = 0
      omit_runner = 0
    }
    print
    if ($0 ~ /^[[:space:]]+(FAILED|ABORTED)[[:space:]]+[0-9]+\/[0-9]+/) {
      print ""
      in_failure = 0
    }
    next
  }

  /^(Aborted: )?Ran [0-9]+ tests?, / {
    in_summary = 1
    saw_summary = 1
  }

  in_summary {
    print
  }
  END { if (!saw_summary) exit 1 }
' "$log_file" >"$brief_file"
then
  cat "$brief_file"
else
  # A test process can fail after printing an ordinary failure block but
  # before ERT summarizes the run.  Preserve the full fatal/abort diagnostic
  # instead of returning a plausible-looking incomplete brief.
  cat "$log_file"
fi

exit "$status"
