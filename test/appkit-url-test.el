;;; appkit-url-test.el --- URL handler ownership and dispatch -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'appkit-url)

(ert-deftest appkit-url-mode-preserves-user-rules-and-unclaimed-urls ()
  "Package defaults yield to user rules and leave ordinary browsing alone."
  (let* ((appkit-url--handlers nil)
         (appkit-url-mode nil)
         (browse-url-handlers nil)
         (other '("\\`mailto:" . ignore))
         (browse-url-default-handlers (list other))
         (browse-url-browser-function 'browse-url-default-browser)
         (handler (make-symbol "appkit-url-test-open")))
    (fset handler #'ignore)
    (appkit-url-register 'test "\\`https://app.example/" handler)
    (should-not (browse-url-select-handler "https://app.example/item"))
    (appkit-url-mode 1)
    (should (eq (browse-url-select-handler "https://app.example/item") handler))
    (should (eq (browse-url-select-handler "https://app.example/item" 'internal)
                handler))
    (should-not (browse-url-select-handler "https://app.example/item" 'external))
    (should-not (browse-url-select-handler "https://ordinary.example/"))
    (let ((browse-url-handlers '(("\\`https://app.example/" . user-browser))))
      (should (eq (browse-url-select-handler "https://app.example/item")
                  'user-browser)))
    (appkit-url-mode -1)
    (should (equal browse-url-default-handlers (list other)))
    (should (eq browse-url-browser-function 'browse-url-default-browser))))

(ert-deftest appkit-url-registration-can-change-while-mode-is-active ()
  "Late registration, replacement, and repeated enabling keep one owned rule."
  (let ((appkit-url--handlers nil)
        (appkit-url-mode nil)
        (browse-url-handlers nil)
        (browse-url-default-handlers nil)
        (handler (make-symbol "appkit-url-test-live-open")))
    (fset handler #'ignore)
    (appkit-url-mode 1)
    (appkit-url-register 'test "\\`https://old.example/" handler)
    (appkit-url-register 'test "\\`https://new.example/" handler)
    (appkit-url-mode 1)
    (should (= (length browse-url-default-handlers) 1))
    (should-not (browse-url-select-handler "https://old.example/item"))
    (should (eq (browse-url-select-handler "https://new.example/item") handler))
    (appkit-url-mode -1)
    (should-not browse-url-default-handlers)
    (appkit-url-mode 1)
    (should (eq (browse-url-select-handler "https://new.example/item") handler))
    (appkit-url-unregister 'test)
    (should-not browse-url-default-handlers)
    (should-not appkit-url--handlers)))

(ert-deftest appkit-url-mode-does-not-remove-equivalent-unowned-rules ()
  "Disabling must preserve an identical rule that Appkit did not install."
  (let* ((appkit-url--handlers nil)
         (appkit-url-mode nil)
         (handler (make-symbol "appkit-url-test-shared-open"))
         (unowned (cons "\\`https://app.example/" handler))
         (browse-url-default-handlers (list unowned)))
    (fset handler #'ignore)
    (appkit-url-register 'test (car unowned) handler)
    (appkit-url-mode 1)
    (should (equal browse-url-default-handlers (list unowned)))
    (appkit-url-mode -1)
    (should (eq (car browse-url-default-handlers) unowned))
    (appkit-url-unregister 'test)
    (should (eq (car browse-url-default-handlers) unowned))))

(ert-deftest appkit-url-external-opening-selects-only-external-handlers ()
  "The explicit browser exit asks Browse URL for an external browser."
  (let (call)
    (cl-letf (((symbol-function 'browse-url-with-browser-kind)
               (lambda (&rest args) (setq call args))))
      (appkit-url-open-external "https://app.example/item" t))
    (should (equal call '(external "https://app.example/item" t)))))

(provide 'appkit-url-test)

;;; appkit-url-test.el ends here
