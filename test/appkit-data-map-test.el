;;; appkit-data-map-test.el --- Persistent collection contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'appkit-data-map)

(ert-deftest appkit-data-map-batches-preserve-published-snapshots ()
  (let* ((values (cl-loop for i below 300 collect (cons (list "message" i) (list :text i))))
         (before (appkit-data-map-edit appkit-data-map-empty values))
         (after (appkit-data-map-edit before
                  (list (cons '("message" 0) nil)
                        (cons '("message" 1) appkit-data-delete)
                        (cons '("message" 300) 'new)
                        (cons '("message" 300) 'newer)))))
    (should (= 300 (appkit-data-map-count before) (appkit-data-map-count after)))
    (should (equal (appkit-data-map-get before '("message" 0)) '(:text 0)))
    (should-not (appkit-data-map-get after '("message" 0) 'missing))
    (should (eq 'missing (appkit-data-map-get after '("message" 1) 'missing)))
    (should (eq 'newer (appkit-data-map-get after '("message" 300))))
    (should (eq (appkit-data-map-get before '("message" 2))
                (appkit-data-map-get after '("message" 2))))
    (should (eq before (appkit-data-map-set before '("message" 0) (list :text 0))))
    (should (eq before (appkit-data-map-remove before 'absent)))
    (let ((diff (appkit-data-map-diff before after)))
      (should (= 3 (length diff)))
      (should (equal (cdr (assoc '("message" 0) diff)) '((:text 0) nil)))
      (should (eq appkit-data-absent (nth 2 (assoc '("message" 1) diff))))
      (should (eq appkit-data-absent (nth 1 (assoc '("message" 300) diff)))))
    (should-error (appkit-data-map-edit before '((extra . value) invalid)))
    (should-error (appkit-data-map-set before 'extra appkit-data-absent))
    (should (= 300 (appkit-data-map-count before)))
    (should (eq 'missing (appkit-data-map-get before 'extra 'missing)))))

(ert-deftest appkit-data-map-full-hash-collisions-and-shared-prefixes ()
  (cl-letf (((symbol-function 'appkit-data--hash)
             (lambda (key) (pcase key ('far 1024) ('near 32) (_ 0)))))
    (let* ((before (appkit-data-map-edit appkit-data-map-empty
                     '((a . 1) (b . 2) (c . 3) (near . 4) (far . 5))))
           (after (appkit-data-map-edit before
                    (list (cons 'b 20) (cons 'a appkit-data-delete)
                          (cons 'near appkit-data-delete) (cons 'far appkit-data-delete))))
           (last (appkit-data-map-remove after 'c)))
      (should (= 5 (appkit-data-map-count before)))
      (should (= 2 (appkit-data-map-count after)))
      (should (= 20 (appkit-data-map-get last 'b)))
      (should (= 1 (appkit-data-map-count last)))
      (should (eq appkit-data-map-empty (appkit-data-map-remove last 'b)))
      (should (= 1 (appkit-data-map-get before 'a)))
      (should (= 4 (length (appkit-data-map-diff before after)))))))

(ert-deftest appkit-data-map-random-edits-match-reference-and-replay-diffs ()
  (let ((map appkit-data-map-empty)
        (reference (make-hash-table :test #'equal))
        versions)
    (random "appkit-data-map-contract")
    (dotimes (step 750)
      (when (zerop (% step 75)) (push (cons map (copy-hash-table reference)) versions))
      (let* ((key (list "entity" (random 160)))
             (remove-p (zerop (random 3)))
             (value (and (not (zerop (random 4))) (random 100))))
        (setq map (if remove-p (appkit-data-map-remove map key)
                    (appkit-data-map-set map key value)))
        (if remove-p (remhash key reference) (puthash key value reference))))
    (dolist (version (cons (cons map reference) versions))
      (let ((old (car version)) (expected (cdr version)))
        (should (= (hash-table-count expected) (appkit-data-map-count old)))
        (maphash (lambda (key value)
                   (should (equal value (appkit-data-map-get old key appkit-data-absent))))
                 expected)
        (let ((replayed (appkit-data-map-edit
                         old (mapcar (lambda (change)
                                       (cons (car change)
                                             (if (eq (nth 2 change) appkit-data-absent)
                                                 appkit-data-delete (nth 2 change))))
                                     (appkit-data-map-diff old map)))))
          (should-not (appkit-data-map-diff replayed map)))))))

(ert-deftest appkit-data-map-diff-skips-an-unchanged-large-collection ()
  (let* ((before (appkit-data-map-edit appkit-data-map-empty
                   (cl-loop for i below 5000 collect (cons i i))))
         (after (appkit-data-map-set before 2345 'updated))
         (hash-function (symbol-function 'appkit-data--hash))
         (calls 0))
    (cl-letf (((symbol-function 'appkit-data--hash)
               (lambda (key) (cl-incf calls) (funcall hash-function key))))
      (should (equal (appkit-data-map-diff before after) '((2345 2345 updated))))
      (should (< calls 64)))))
(provide 'appkit-data-map-test)
